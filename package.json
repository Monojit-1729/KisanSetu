{
  "name": "kisansetu",
  "version": "0.1.0",
  "private": true,
  "description": "KisanSetu - Strengthening market linkages and price discovery for farmers (SIH 26132)",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:client": "npm run dev:frontend",
    "dev:server": "npm run dev:backend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
