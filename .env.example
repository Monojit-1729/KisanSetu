# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas / Local MongoDB)
# Example local: mongodb://localhost:27017/kisansetu
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/kisansetu?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/kisansetu

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Market Intelligence Pilot Configuration (Default: Maharashtra)
PILOT_STATE=Maharashtra
DEFAULT_CROPS=Onion,Soybean,Tomato
