# KisanSetu Backend Environment Configuration

# Server Port and Mode
PORT=5000
NODE_ENV=development

# Client Origin for CORS (supports comma-separated URLs)
# Local development:
CLIENT_URL=http://localhost:5173
# Production example:
# CLIENT_URL=https://kisansetu.vercel.app

# Database Connection (MongoDB Atlas in Production, local MongoDB in Dev)
# Local:
MONGODB_URI=mongodb://localhost:27017/kisansetu
# Atlas Production example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kisansetu?retryWrites=true&w=majority

# Authentication Secret (Must be set to a cryptographically strong string in production)
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Market Pilot Configuration
PILOT_STATE=Maharashtra
DEFAULT_CROPS=Onion,Soybean,Tomato
